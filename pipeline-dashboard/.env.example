# ---------------------------------------------------------------------------
# Copy this file to .env.local for local development, and set the SAME values
# as Environment Variables in your Vercel project for production.
# ---------------------------------------------------------------------------

# Login accounts (shared password-based auth).
# Format: "username:password" pairs separated by commas.
# Add or remove users by editing this one value.
APP_USERS=admin:change-this-password,teammate:another-password

# Secret used to sign login session cookies. Use a long random string.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=please-change-me-to-a-long-random-string

# Postgres connection string.
# On Vercel, adding the Neon (Postgres) integration sets POSTGRES_URL for you
# automatically — you usually do NOT need to set this by hand in production.
# For local dev, paste your Neon connection string here.
POSTGRES_URL=
